<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="680.0" prefWidth="1034.0" xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpmgc.vectorrally.app.javafxView.LoserHandler">
   <ImageView fx:id="loseImage" fitHeight="699.0" fitWidth="1067.0" layoutY="-6.0" pickOnBounds="true" preserveRatio="true">
      <Image url="@images/backgroundGameOver.png"/>
   </ImageView>
   <Button fx:id="goToHomeButton" layoutX="25.0" layoutY="580.0" mnemonicParsing="false" onAction="#handleGoToHome"
           prefHeight="50.0" prefWidth="132.0" text="Play Again">
      <font>
         <Font size="14.0"/>
      </font>
   </Button>
</AnchorPane>
