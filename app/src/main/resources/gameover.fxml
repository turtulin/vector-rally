<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="680.0" prefWidth="1034.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpmgc.vectorrally.app.javafxView.LoserHandler">
   <children>
      <ImageView fitHeight="699.0" fitWidth="1067.0" layoutY="-6.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/backgroundGameOver.png" />
         </image>
      </ImageView>
      <Button fx:id="playAgainButton" layoutX="23.0" layoutY="520.0" mnemonicParsing="false" onAction="#handlePlayAgainButtonAction" prefHeight="50.0" prefWidth="132.0" text="Play Again">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button fx:id="quitGameButton" layoutX="23.0" layoutY="586.0" mnemonicParsing="false" onAction="#handleQuitGameButtonAction" prefHeight="50.0" prefWidth="132.0" text="Quit Game">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
