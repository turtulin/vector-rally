<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="708.0" prefWidth="1078.0" xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpmgc.vectorrally.app.javafxView.WinnerHandler">
   <ImageView fx:id="winImage" fitHeight="724.0" fitWidth="1100.0" layoutX="-1.0" layoutY="-5.0" pickOnBounds="true"
              preserveRatio="true">
      <Image url="@images/backgroundCongratulations.png"/>
   </ImageView>
   <Button fx:id="goToHomeButton" layoutX="27.0" layoutY="610.0" mnemonicParsing="false" onAction="#handleGoToHome"
           prefHeight="50.0" prefWidth="132.0" text="Play Again">
      <font>
         <Font size="14.0"/>
      </font>
   </Button>
   <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ff007751" height="62.0" layoutX="331.0" layoutY="82.0"
              stroke="WHITE" strokeType="INSIDE" width="733.0"/>
   <Label fx:id="playerNameLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="341.0" layoutY="99.0"
          prefHeight="29.0" prefWidth="713.0" text="Winner Name" textAlignment="CENTER" textFill="WHITE">
      <font>
         <Font name="Noto Sans ExtraBold" size="20.0"/>
      </font>
   </Label>
</AnchorPane>
